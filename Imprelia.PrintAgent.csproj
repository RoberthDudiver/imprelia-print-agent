<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows habilita WinForms (NotifyIcon de la bandeja del sistema) + WPF -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ImpreliaPrintAgent</AssemblyName>
    <Product>Imprelia Print Agent</Product>
    <Company>Dudiver</Company>
    <Authors>Roberth Dudiver</Authors>
    <Copyright>© 2026 Roberth Dudiver — dudiver.net</Copyright>
    <Description>Local print agent with HTTP API for Windows printers (ESC/POS, RAW, ZPL, PDF).</Description>
    <PackageProjectUrl>https://www.dudiver.net</PackageProjectUrl>
    <Version>1.1.6</Version>
    <!-- Para publicar como un solo .exe portable, ver README del agente. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>images\icono.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="images\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Imprelia.Server y examples son proyectos aparte que viven como subcarpetas
       de este repo. El SDK hace globbing por defecto (**/*.cs); hay que excluirlos
       para que el agente NO intente compilar código ASP.NET que no referencia. -->
  <ItemGroup>
    <Compile Remove="Imprelia.Server\**\*.cs;examples\**\*.cs" />
    <Content Remove="Imprelia.Server\**\*;examples\**\*" />
    <None Remove="Imprelia.Server\**\*;examples\**\*" />
    <EmbeddedResource Remove="Imprelia.Server\**\*;examples\**\*" />
    <Page Remove="Imprelia.Server\**\*.xaml;examples\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Remote Print Bridge: cliente SignalR para conectarse al servidor remoto -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.*" />
  </ItemGroup>

</Project>
