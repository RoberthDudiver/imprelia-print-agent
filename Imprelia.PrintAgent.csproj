<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows habilita WinForms (NotifyIcon de la bandeja del sistema) -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ImpreliaPrintAgent</AssemblyName>
    <Product>Imprelia Print Agent</Product>
    <Company>Dudiver</Company>
    <Authors>Roberth Dudiver</Authors>
    <Copyright>© 2026 Roberth Dudiver — dudiver.net</Copyright>
    <Description>Local print agent with HTTP API for Windows printers (ESC/POS, RAW, ZPL, PDF).</Description>
    <PackageProjectUrl>https://www.dudiver.net</PackageProjectUrl>
    <Version>1.0.0</Version>
    <!-- Para publicar como un solo .exe portable, ver README del agente. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>images\icono.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="images\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SettingsForm.Designer.cs">
      <DependentUpon>SettingsForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="SettingsForm.resx">
      <DependentUpon>SettingsForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
