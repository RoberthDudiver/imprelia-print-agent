<UserControl x:Class="Imprelia.PrintAgent.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Imprelia.PrintAgent.Localization"
             Background="#0B1426">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
            <TextBlock Text="{loc:Tr printers.title}" Style="{StaticResource T.PageTitle}"/>
            <TextBlock Text="{loc:Tr printers.subtitle}" Style="{StaticResource T.PageSub}"/>
        </StackPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="{loc:Tr printers.refresh}" Command="{Binding RefreshCommand}"
                        Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0"/>
                <Button Content="{loc:Tr printers.setDefault}" Command="{Binding SetAsDefaultCommand}"
                        Style="{StaticResource Btn.Primary}" Margin="0,0,8,0"/>
                <Button Content="{loc:Tr printers.printTest}" Command="{Binding PrintTestCommand}"
                        Style="{StaticResource Btn.Ghost}"/>
            </StackPanel>
            <TextBox DockPanel.Dock="Right"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input.Search}"
                     Width="240" HorizontalAlignment="Right">
                <TextBox.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource Input.Search}"/>
                </TextBox.Resources>
            </TextBox>
        </DockPanel>

        <!-- Printer table -->
        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table header -->
                <Border Grid.Row="0" Background="#0B1E3A" CornerRadius="10,10,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Tr printers.colName}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr printers.colStatus}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{loc:Tr printers.colType}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="{loc:Tr printers.colCaps}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="{loc:Tr printers.colDefault}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="{loc:Tr printers.colActions}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- Table rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredPrinters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#111E36"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Nombre -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Type}" FontSize="11"
                                                       Foreground="#64748B"/>
                                        </StackPanel>

                                        <!-- Estado -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#22C55E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                <Setter Property="Fill" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#E2E8F0"/>
                                                <TextBlock Text="{loc:Tr printers.online}" FontSize="10" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Tipo -->
                                        <TextBlock Grid.Column="2" Text="{Binding Type}"
                                                   FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                        <!-- Capacidades -->
                                        <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                            <Border Visibility="{Binding SupportsPdf, Converter={StaticResource BoolToVis}}"
                                                    Background="#1E3A8A" CornerRadius="3" Padding="5,2" Margin="0,0,4,0">
                                                <TextBlock Text="PDF" FontSize="10" Foreground="#60A5FA" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Visibility="{Binding SupportsRaw, Converter={StaticResource BoolToVis}}"
                                                    Background="#1E293B" CornerRadius="3" Padding="5,2" Margin="0,0,4,0">
                                                <TextBlock Text="RAW" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Visibility="{Binding SupportsZpl, Converter={StaticResource BoolToVis}}"
                                                    Background="#134E4A" CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="ZPL" FontSize="10" Foreground="#2DD4BF" FontWeight="SemiBold"/>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Predeterminada -->
                                        <Border Grid.Column="4" VerticalAlignment="Center"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Badge.Green}" CornerRadius="12" Padding="8,3">
                                            <TextBlock Text="{loc:Tr printers.defaultBadge}" FontSize="10"
                                                       Foreground="#22C55E" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Acciones -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="★" ToolTip="Usar como predeterminada"
                                                    Command="{Binding DataContext.SetAsDefaultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Style="{StaticResource Btn.Icon}" FontSize="14" Margin="0,0,4,0"/>
                                            <Button Content="🖨" ToolTip="Imprimir prueba"
                                                    Command="{Binding DataContext.PrintTestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Style="{StaticResource Btn.Icon}" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Detail panel -->
        <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
            <!-- Empty state -->
            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🖨" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{loc:Tr printers.selectPrompt}" FontSize="13" MaxWidth="180"
                           Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Printer detail -->
            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Tr printers.detailTitle}" FontSize="12"
                           Foreground="#64748B" Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="40" Height="40" Background="#1D3A6E" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="🖨" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedPrinter.Name}" FontSize="15"
                                   Foreground="#E2E8F0" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedPrinter.Type}" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SelectedPrinter.Status}" FontSize="12" Foreground="#22C55E"/>
                    <TextBlock Text=" · " FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{loc:Tr printers.online}" FontSize="12" Foreground="#64748B"/>
                </StackPanel>

                <Separator Background="#1E293B" Margin="0,0,0,14"/>

                <!-- Fields -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Tr printers.colType}" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedPrinter.Type}" FontSize="12" Foreground="#E2E8F0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Tr printers.colStatus}" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedPrinter.Status}" FontSize="12" Foreground="#22C55E"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Tr printers.colDefault}" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="—"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPrinter.IsDefault}" Value="True">
                                            <Setter Property="Text" Value="✓"/>
                                            <Setter Property="Foreground" Value="#22C55E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Tr printers.source}" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedPrinter.Source}" FontSize="12" Foreground="#E2E8F0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Tr printers.capsSupported}" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,16">
                    <Border Visibility="{Binding SelectedPrinter.SupportsPdf, Converter={StaticResource BoolToVis}}"
                            Background="#1E3A8A" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                        <TextBlock Text="PDF" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold"/>
                    </Border>
                    <Border Visibility="{Binding SelectedPrinter.SupportsRaw, Converter={StaticResource BoolToVis}}"
                            Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                        <TextBlock Text="RAW" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    </Border>
                    <Border Visibility="{Binding SelectedPrinter.SupportsZpl, Converter={StaticResource BoolToVis}}"
                            Background="#134E4A" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                        <TextBlock Text="ZPL" FontSize="11" Foreground="#2DD4BF" FontWeight="SemiBold"/>
                    </Border>
                </WrapPanel>

                <!-- Notification -->
                <Border Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}"
                        Background="#14532D" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Notification}" FontSize="12" Foreground="#22C55E"
                               TextWrapping="Wrap"/>
                </Border>

                <Button Content="{loc:Tr printers.printTest}" Command="{Binding PrintTestCommand}"
                        Style="{StaticResource Btn.Primary}" HorizontalAlignment="Stretch" Height="38"/>
                <Button Content="{loc:Tr printers.setDefaultBtn}" Command="{Binding SetAsDefaultCommand}"
                        Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Stretch"
                        Height="38" Margin="0,8,0,0"/>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
