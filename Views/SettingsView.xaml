<UserControl x:Class="Imprelia.PrintAgent.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1426">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24" MaxWidth="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Configuración del agente" Style="{StaticResource T.PageTitle}"/>
                <TextBlock Text="Ajusta las preferencias de red, seguridad e inicio del agente."
                           Style="{StaticResource T.PageSub}"/>
            </StackPanel>

            <!-- Message banner -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,-50"
                    Visibility="{Binding Message, Converter={StaticResource StrToVis}}"
                    CornerRadius="8" Padding="14,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#14532D"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Background" Value="#450A0A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#22C55E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#F87171"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- Section: Red y conexión -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" Background="#1D3A6E" CornerRadius="7" Margin="0,0,12,0">
                            <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Red y conexión" FontSize="14" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <TextBlock Text="Configura el puerto de escucha del agente."
                                       FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="#1E293B" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Puerto HTTP" FontSize="13"
                                   Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input.Number}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" FontSize="12" Foreground="#64748B"
                                   VerticalAlignment="Center" TextWrapping="Wrap">
                            El agente escucha en 127.0.0.1 por defecto.&#10;Solo conexiones locales serán aceptadas.
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: CORS -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" Background="#1D3A6E" CornerRadius="7" Margin="0,0,12,0">
                            <TextBlock Text="🛡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CORS y orígenes permitidos" FontSize="14"
                                       Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <TextBlock Text="Define qué sitios web pueden comunicarse con el agente."
                                       FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="#1E293B" Margin="0,0,0,16"/>

                    <CheckBox Content="Permitir CORS" IsChecked="{Binding AllowCors}"
                              Style="{StaticResource Input.Check}" Margin="0,0,0,16"/>

                    <TextBlock Text="Orígenes permitidos (uno por línea)" FontSize="12"
                               Foreground="#64748B" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding AllowedOrigins, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input.MultiLine}"
                                 Height="100"/>

                        <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="12"
                                VerticalAlignment="Top">
                            <TextBlock FontSize="11" Foreground="#64748B" TextWrapping="Wrap">
                                Si la lista queda vacía, se permite cualquier origen.&#10;&#10;Ejemplo:&#10;http://localhost:3000&#10;https://miapp.local
                            </TextBlock>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: Inicio Windows -->
            <Border Grid.Row="6" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" Background="#1D3A6E" CornerRadius="7" Margin="0,0,12,0">
                            <TextBlock Text="⊞" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Inicio de Windows" FontSize="14"
                                       Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <TextBlock Text="Controla el comportamiento al iniciar el sistema."
                                       FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="#1E293B" Margin="0,0,0,16"/>

                    <CheckBox Content="Abrir automáticamente al iniciar Windows"
                              IsChecked="{Binding AutoStart}"
                              Style="{StaticResource Input.Check}"/>
                </StackPanel>
            </Border>

            <!-- Action bar -->
            <DockPanel Grid.Row="8">
                <Button Content="↩ Restaurar valores" Command="{Binding RestoreDefaultsCommand}"
                        Style="{StaticResource Btn.Ghost}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                <Button Content="🔗 Copiar URL" Command="{Binding CopyUrlCommand}"
                        Style="{StaticResource Btn.Ghost}" DockPanel.Dock="Left"/>
                <Button Content="💾 Guardar cambios" Command="{Binding SaveCommand}"
                        Style="{StaticResource Btn.Primary}" DockPanel.Dock="Right"/>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
