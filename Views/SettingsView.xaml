<UserControl x:Class="Imprelia.PrintAgent.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Imprelia.PrintAgent.Localization"
             Background="#0B1426">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24" MaxWidth="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{loc:Tr settings.title}" Style="{StaticResource T.PageTitle}"/>
                <TextBlock Text="{loc:Tr settings.subtitle}" Style="{StaticResource T.PageSub}"/>
            </StackPanel>

            <!-- Message banner -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,-50"
                    Visibility="{Binding Message, Converter={StaticResource StrToVis}}"
                    CornerRadius="8" Padding="14,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#14532D"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Background" Value="#450A0A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#22C55E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#F87171"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- Section: Red y conexión -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" Background="#1D3A6E" CornerRadius="7" Margin="0,0,12,0">
                            <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr settings.network}" FontSize="14" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Tr settings.networkSub}" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="#1E293B" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{loc:Tr settings.httpPort}" FontSize="13"
                                   Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input.Number}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{loc:Tr settings.portHint}" FontSize="12" Foreground="#64748B"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: CORS -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" Background="#1D3A6E" CornerRadius="7" Margin="0,0,12,0">
                            <TextBlock Text="🛡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr settings.cors}" FontSize="14"
                                       Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Tr settings.corsSub}" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="#1E293B" Margin="0,0,0,16"/>

                    <CheckBox Content="{loc:Tr settings.allowCors}" IsChecked="{Binding AllowCors}"
                              Style="{StaticResource Input.Check}" Margin="0,0,0,16"/>

                    <TextBlock Text="{loc:Tr settings.origins}" FontSize="12"
                               Foreground="#64748B" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding AllowedOrigins, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input.MultiLine}"
                                 Height="100"/>

                        <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="12"
                                VerticalAlignment="Top">
                            <TextBlock Text="{loc:Tr settings.originsHint}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: Inicio Windows -->
            <Border Grid.Row="6" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" Background="#1D3A6E" CornerRadius="7" Margin="0,0,12,0">
                            <TextBlock Text="⊞" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr settings.startup}" FontSize="14"
                                       Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Tr settings.startupSub}" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="#1E293B" Margin="0,0,0,16"/>

                    <CheckBox Content="{loc:Tr settings.autostart}"
                              IsChecked="{Binding AutoStart}"
                              Style="{StaticResource Input.Check}"/>
                </StackPanel>
            </Border>

            <!-- Section: Idioma -->
            <Border Grid.Row="8" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" Background="#1D3A6E" CornerRadius="7" Margin="0,0,12,0">
                            <TextBlock Text="🌎" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr settings.language}" FontSize="14"
                                       Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Tr settings.languageSub}" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="#1E293B" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{loc:Tr settings.langEs}" GroupName="lang"
                                     IsChecked="{Binding IsSpanish, Mode=TwoWay}"
                                     Foreground="#E2E8F0" Margin="0,0,24,0" FontSize="13"/>
                        <RadioButton Content="{loc:Tr settings.langEn}" GroupName="lang"
                                     IsChecked="{Binding IsEnglish, Mode=TwoWay}"
                                     Foreground="#E2E8F0" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section: Rol -->
            <Border Grid.Row="10" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" Background="#1D3A6E" CornerRadius="7" Margin="0,0,12,0">
                            <TextBlock Text="🖧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr settings.role}" FontSize="14"
                                       Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Tr settings.roleSub}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#1E293B" Margin="0,0,0,16"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{loc:Tr settings.reconfigure}"
                                Command="{Binding ReconfigureCommand}" Style="{StaticResource Btn.Primary}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding RoleLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Action bar -->
            <DockPanel Grid.Row="12">
                <Button Content="↩" Command="{Binding RestoreDefaultsCommand}"
                        Style="{StaticResource Btn.Ghost}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                <Button Content="🔗" Command="{Binding CopyUrlCommand}"
                        Style="{StaticResource Btn.Ghost}" DockPanel.Dock="Left"/>
                <Button Content="{loc:Tr settings.save}" Command="{Binding SaveCommand}"
                        Style="{StaticResource Btn.Primary}" DockPanel.Dock="Right"/>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
