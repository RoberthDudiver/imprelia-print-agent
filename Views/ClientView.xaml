<UserControl x:Class="Imprelia.PrintAgent.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Imprelia.PrintAgent.Localization"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="24,20,24,24" MaxWidth="720">

            <!-- Título -->
            <TextBlock Style="{StaticResource T.PageTitle}" Text="{loc:Tr client.title}"/>
            <TextBlock Style="{StaticResource T.PageSub}" TextWrapping="Wrap" Text="{loc:Tr client.subtitle}"/>

            <!-- Banner de mensaje -->
            <Border Margin="0,4,0,12" CornerRadius="8" Padding="12,10"
                    Visibility="{Binding Message, Converter={StaticResource StrToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#0E2A1B"/>
                        <Setter Property="BorderBrush" Value="#22C55E"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Background" Value="#2A0E12"/>
                                <Setter Property="BorderBrush" Value="#EF4444"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                           Foreground="#E2E8F0"/>
            </Border>

            <!-- ── Habilitar modo cliente ─────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                              Style="{StaticResource Input.Check}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr client.enable}" Foreground="#E2E8F0"
                                       FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="{loc:Tr client.enableSub}"
                                       Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Tr client.ippPort}" Style="{StaticResource T.Label}"/>
                            <TextBox Text="{Binding IppPort, Mode=TwoWay}"
                                     Style="{StaticResource Input.Number}" Width="120"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#6B7280"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ServerRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ServerStatusLabel}" FontSize="12"
                                           Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="{loc:Tr client.save}" Command="{Binding SaveCommand}"
                                Style="{StaticResource Btn.Primary}" Margin="0,0,8,0"/>
                        <Button Content="{loc:Tr client.testHub}" Command="{Binding TestHubCommand}"
                                Style="{StaticResource Btn.Ghost}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="{loc:Tr client.hubHint}"/>
                </StackPanel>
            </Border>

            <!-- ── Impresoras virtuales ───────────────────────────── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="{loc:Tr client.virtualPrinters}"
                                   Style="{StaticResource T.CardTitle}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Tr client.new}" Command="{Binding AddCommand}"
                                    Style="{StaticResource Btn.Primary}" Height="28" Padding="10,0"
                                    FontSize="12" Margin="0,0,6,0"/>
                            <Button Content="{loc:Tr client.edit}" Command="{Binding EditCommand}"
                                    Style="{StaticResource Btn.Ghost}" Height="28" Padding="10,0"
                                    FontSize="12" Margin="0,0,6,0"/>
                            <Button Content="{loc:Tr client.remove}" Command="{Binding DeleteCommand}"
                                    Style="{StaticResource Btn.Danger}" Height="28" Padding="10,0"
                                    FontSize="12"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Formulario de edición -->
                    <Border Margin="0,4,0,12" CornerRadius="8" Padding="14" Background="#0B1E3A"
                            BorderBrush="#1E293B" BorderThickness="1"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.CardTitle}" Text="{Binding EditFormTitle}"/>

                            <TextBlock Text="{loc:Tr client.localName}" Style="{StaticResource T.Label}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding EditLocalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.Text}"/>

                            <TextBlock Text="{loc:Tr client.targetAgent}" Style="{StaticResource T.Label}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding EditAgentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.Text}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Tr client.targetPrinter}" Style="{StaticResource T.Label}"/>
                                    <TextBox Text="{Binding EditPrinter, Mode=TwoWay}"
                                             Style="{StaticResource Input.Text}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Tr client.route}" Style="{StaticResource T.Label}"/>
                                    <TextBox Text="{Binding EditRoute, Mode=TwoWay}"
                                             Style="{StaticResource Input.Text}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{loc:Tr client.targetHint}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{loc:Tr client.saveBtn}" Command="{Binding SaveEditCommand}"
                                        Style="{StaticResource Btn.Primary}" Margin="0,0,8,0"/>
                                <Button Content="{loc:Tr client.cancelBtn}" Command="{Binding CancelEditCommand}"
                                        Style="{StaticResource Btn.Ghost}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Lista de impresoras virtuales -->
                    <ListBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="8" Padding="12,10"
                                                    Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1A3460"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#111E36"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding LocalName}" FontSize="13"
                                                   Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="→ " FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding TargetAgentId}" FontSize="11" Foreground="#60A5FA"/>
                                            <TextBlock Text=" / " FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding TargetPrinter}" FontSize="11" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding Route}" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center"
                                            CornerRadius="10" Padding="8,3"
                                            Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}"
                                            Background="#0E2A1B" BorderBrush="#22C55E" BorderThickness="1">
                                        <TextBlock Text="{loc:Tr client.installedBadge}" FontSize="10" Foreground="#22C55E"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Acciones de provisión -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Tr client.install}" Command="{Binding InstallCommand}"
                                Style="{StaticResource Btn.Primary}" Margin="0,0,8,0"/>
                        <Button Content="{loc:Tr client.uninstall}" Command="{Binding UninstallCommand}"
                                Style="{StaticResource Btn.Ghost}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{loc:Tr client.provisionHint}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
