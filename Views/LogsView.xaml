<UserControl x:Class="Imprelia.PrintAgent.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1426">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
            <TextBlock Text="Logs del agente" Style="{StaticResource T.PageTitle}"/>
            <TextBlock Text="Consulta la actividad del agente para diagnóstico y solución de problemas."
                       Style="{StaticResource T.PageSub}"/>
        </StackPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="2" Grid.Column="0">
            <!-- Search -->
            <TextBox DockPanel.Dock="Left"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input.Search}"
                     Width="220" Margin="0,0,16,0"/>

            <!-- Level filters -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Nivel:" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Todos" Command="{Binding FilterAllCommand}" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.FilterTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterLevel}" Value="Todos">
                                    <Setter Property="Background" Value="{StaticResource Accent.Blue}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent.Blue}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Info" Command="{Binding FilterInfoCommand}" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.FilterTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterLevel}" Value="Info">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Warning" Command="{Binding FilterWarnCommand}" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.FilterTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterLevel}" Value="Warning">
                                    <Setter Property="Background" Value="{StaticResource Accent.YellowBg}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent.Yellow}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Accent.Yellow}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Error" Command="{Binding FilterErrorCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.FilterTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterLevel}" Value="Error">
                                    <Setter Property="Background" Value="{StaticResource Accent.RedBg}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent.Red}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Accent.Red}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Auto-refresh toggle -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Auto-actualizar" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- Actions row -->
        <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Top"
                    Orientation="Horizontal" Margin="0,0,0,10">
            <!-- Placeholder: action buttons above table -->
        </StackPanel>

        <!-- Logs table -->
        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Table header -->
                <Border Grid.Row="0" Background="#0B1E3A" CornerRadius="10,10,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fecha / Hora" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Nivel" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Módulo" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Mensaje" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,9" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#111E36"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TimeFormatted}"
                                                   FontSize="12" Foreground="#64748B"
                                                   FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <!-- Level badge -->
                                        <Border Grid.Column="1" CornerRadius="4" Padding="5,2"
                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E3A8A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                            <Setter Property="Background" Value="{StaticResource Accent.YellowBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                            <Setter Property="Background" Value="{StaticResource Accent.RedBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent.Cyan}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent.Yellow}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent.Red}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding Module}"
                                                   FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding Message}"
                                                   FontSize="12" Foreground="#E2E8F0"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#0B1E3A" CornerRadius="0,0,10,10" Padding="16,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="📋 Copiar logs" Command="{Binding CopyLogsCommand}"
                                    Style="{StaticResource Btn.Ghost}" Height="26"
                                    Padding="8,0" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="🗑 Limpiar" Command="{Binding ClearLogsCommand}"
                                    Style="{StaticResource Btn.Danger}" Height="26"
                                    Padding="8,0" FontSize="11"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#64748B" VerticalAlignment="Center">
                            Mostrando
                            <Run Text="{Binding FilteredLogs.Count, Mode=OneWay}"/>
                            entradas
                        </TextBlock>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Summary panel -->
        <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="☰ Resumen de logs" Style="{StaticResource T.CardTitle}" Margin="0,0,0,16"/>

                <TextBlock Text="Total de eventos hoy" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding TotalToday}" FontSize="28" FontWeight="Bold"
                           Foreground="#E2E8F0" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Width="50" Margin="0,0,8,0">
                        <TextBlock Text="Info" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding InfoCount}" FontSize="14"
                               Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="{StaticResource Accent.YellowBg}" CornerRadius="4" Padding="6,2" Width="50" Margin="0,0,8,0">
                        <TextBlock Text="Warn" FontSize="11" Foreground="{StaticResource Accent.Yellow}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding WarnCount}" FontSize="14"
                               Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Background="{StaticResource Accent.RedBg}" CornerRadius="4" Padding="6,2" Width="50" Margin="0,0,8,0">
                        <TextBlock Text="Error" FontSize="11" Foreground="{StaticResource Accent.Red}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding ErrorCount}" FontSize="14"
                               Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Background="#1E293B" Margin="0,0,0,14"/>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Última actualización" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding LastUpdateFormatted}" FontSize="12"
                               Foreground="#E2E8F0" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Primer evento hoy" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding FirstTodayFormatted}" FontSize="12"
                               Foreground="#E2E8F0" FontFamily="Consolas"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
