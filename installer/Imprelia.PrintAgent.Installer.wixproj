<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>ImpreliaPrintAgent-Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PublishDir>$(MSBuildThisFileDirectory)..\artifacts\publish\win-x64</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
    <Compile Include="GeneratedFiles.wxs" />
  </ItemGroup>

  <!--
    PublishApplication: publica la app y regenera el manifest de archivos WiX.
    Si ya existe contenido en PublishDir (ej: el workflow ya publicó explícitamente),
    el MSBuild detecta que los outputs están al día y omite el publish.
    La generación del WiX manifest siempre corre para garantizar consistencia.
  -->
  <Target Name="PublishApplication" BeforeTargets="CoreCompile">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\Imprelia.PrintAgent.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;PublishDir=$(PublishDir)"
      Condition="!Exists('$(PublishDir)\ImpreliaPrintAgent.exe')" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\Generate-WixFiles.ps1&quot; -SourceDir &quot;$(PublishDir)\.&quot; -OutputPath &quot;$(MSBuildThisFileDirectory)GeneratedFiles.wxs&quot;" />
  </Target>
</Project>
